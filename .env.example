# =============================================================================
# AI-OSS.net — Environment variable template (§3, §4, §24.4)
# -----------------------------------------------------------------------------
# Copy to .env.local for local dev. NEVER commit real values.
# Vars prefixed NEXT_PUBLIC_* are exposed to the client bundle — keep secrets OUT.
# Each variable lists the owning phase that actually wires it up.
# Provisioning steps: docs/runbooks/provisioning.md
# =============================================================================

# --- Canonical domain (§2 REQ-CORE-001/002) ---
NEXT_PUBLIC_SITE_URL="https://www.ai-oss.net"
NEXT_PUBLIC_CANONICAL_HOST="www.ai-oss.net"

# --- Supabase: Auth (§3.2, Phase 03) + Postgres (§3.3, Phase 01) + Realtime (§3.5, Phase 10) ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SECRET — server only. Must never reach the client bundle.
SUPABASE_SERVICE_ROLE_KEY=""
# SECRET — direct Postgres connection string (Phase 01).
DATABASE_URL=""

# --- Vercel Blob (§3.4, Phase 06) ---
# SECRET — server only.
BLOB_READ_WRITE_TOKEN=""

# --- LiveKit Cloud (§3.6, Phase 11) ---
NEXT_PUBLIC_LIVEKIT_URL=""
# SECRET — server only.
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# --- Stripe (§3.7, Phase 17) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# SECRET — server only.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- BotID / Vercel WAF + rate limiting (§3.8, Phases 14/19) ---
# SECRET — server only.
BOTID_SECRET=""

# --- Upstash Redis (app rate limits, §3.8, Phases 14/19) ---
UPSTASH_REDIS_REST_URL=""
# SECRET — server only.
UPSTASH_REDIS_REST_TOKEN=""
